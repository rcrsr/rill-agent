{
  "name": "ahi-caller",
  "version": "0.1.0",
  "main": "main.rill:caller",
  "extensions": {
    "mounts": {
      "ahi": "@rcrsr/rill-agent-ext-ahi"
    },
    "config": {
      "ahi": {
        "agents": {
          "echo": { "url": "http://localhost:3001" }
        },
        "timeout": 10000
      }
    }
  }
}
